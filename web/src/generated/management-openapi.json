{
  "components": {
    "schemas": {
      "ApplicationState": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "default": "",
            "maxLength": 500,
            "title": "Error",
            "type": "string"
          },
          "force_stop_available": {
            "default": false,
            "title": "Force Stop Available",
            "type": "boolean"
          },
          "phase": {
            "default": "unavailable",
            "enum": [
              "stopped",
              "starting",
              "running",
              "stopping",
              "failed",
              "unavailable"
            ],
            "title": "Phase",
            "type": "string"
          }
        },
        "title": "ApplicationState",
        "type": "object"
      },
      "DeploymentServiceState": {
        "additionalProperties": false,
        "properties": {
          "exit_code": {
            "anyOf": [
              {
                "maximum": 255.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exit Code"
          },
          "phase": {
            "$ref": "#/components/schemas/ServicePhase"
          },
          "reason": {
            "default": "",
            "maxLength": 64,
            "pattern": "^[a-z_]*$",
            "title": "Reason",
            "type": "string"
          },
          "service_id": {
            "$ref": "#/components/schemas/ServiceId"
          }
        },
        "required": [
          "service_id",
          "phase"
        ],
        "title": "DeploymentServiceState",
        "type": "object"
      },
      "DeploymentServicesOut": {
        "additionalProperties": false,
        "properties": {
          "observed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed At"
          },
          "services": {
            "items": {
              "$ref": "#/components/schemas/DeploymentServiceState"
            },
            "maxItems": 23,
            "title": "Services",
            "type": "array"
          }
        },
        "title": "DeploymentServicesOut",
        "type": "object"
      },
      "EndpointState": {
        "additionalProperties": false,
        "properties": {
          "build_id": {
            "default": "",
            "maxLength": 100,
            "title": "Build Id",
            "type": "string"
          },
          "error": {
            "default": "",
            "maxLength": 500,
            "title": "Error",
            "type": "string"
          },
          "phase": {
            "default": "unavailable",
            "enum": [
              "off",
              "connecting",
              "ready",
              "reconnecting",
              "failed",
              "unavailable"
            ],
            "title": "Phase",
            "type": "string"
          },
          "url": {
            "default": "",
            "maxLength": 2048,
            "title": "Url",
            "type": "string"
          }
        },
        "title": "EndpointState",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ManagementAccessAction": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "public_start",
              "public_stop",
              "check"
            ],
            "title": "Action",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "action"
        ],
        "title": "ManagementAccessAction",
        "type": "object"
      },
      "ManagementApplicationAction": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "start",
              "stop",
              "restart",
              "force_stop"
            ],
            "title": "Action",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "action"
        ],
        "title": "ManagementApplicationAction",
        "type": "object"
      },
      "ManagementJob": {
        "properties": {
          "error_code": {
            "default": "",
            "title": "Error Code",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "message": {
            "default": "",
            "title": "Message",
            "type": "string"
          },
          "operation": {
            "title": "Operation",
            "type": "string"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "operation",
          "revision"
        ],
        "title": "ManagementJob",
        "type": "object"
      },
      "RuntimeContext": {
        "properties": {
          "local_browser": {
            "title": "Local Browser",
            "type": "boolean"
          }
        },
        "required": [
          "local_browser"
        ],
        "title": "RuntimeContext",
        "type": "object"
      },
      "RuntimeLogs": {
        "properties": {
          "lines": {
            "items": {
              "type": "string"
            },
            "title": "Lines",
            "type": "array"
          }
        },
        "required": [
          "lines"
        ],
        "title": "RuntimeLogs",
        "type": "object"
      },
      "ServiceId": {
        "enum": [
          "gateway",
          "management",
          "identity",
          "portal",
          "agents",
          "remote",
          "visual",
          "thought",
          "galgame",
          "video",
          "motion",
          "presentation",
          "annotation",
          "director",
          "interview",
          "creative",
          "assets",
          "models",
          "rendering",
          "agent-runtime",
          "integrations",
          "amadeus",
          "tools"
        ],
        "title": "ServiceId",
        "type": "string"
      },
      "ServicePhase": {
        "enum": [
          "running",
          "starting",
          "stopped",
          "paused",
          "restarting",
          "unhealthy",
          "failed",
          "unreachable",
          "not_deployed",
          "unknown",
          "degraded"
        ],
        "title": "ServicePhase",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FPL Management",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/management/access/{target}": {
      "get": {
        "operationId": "access_v1_management_access__target__get",
        "parameters": [
          {
            "in": "path",
            "name": "target",
            "required": true,
            "schema": {
              "enum": [
                "business",
                "management"
              ],
              "title": "Target",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EndpointState"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Access",
        "tags": [
          "management"
        ]
      }
    },
    "/v1/management/access/{target}/actions": {
      "post": {
        "operationId": "access_action_v1_management_access__target__actions_post",
        "parameters": [
          {
            "in": "path",
            "name": "target",
            "required": true,
            "schema": {
              "enum": [
                "business",
                "management"
              ],
              "title": "Target",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManagementAccessAction"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagementJob"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Access Action",
        "tags": [
          "management"
        ]
      }
    },
    "/v1/management/application": {
      "get": {
        "operationId": "application_v1_management_application_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationState"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Application",
        "tags": [
          "management"
        ]
      }
    },
    "/v1/management/application/actions": {
      "post": {
        "operationId": "application_action_v1_management_application_actions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManagementApplicationAction"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagementJob"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Application Action",
        "tags": [
          "management"
        ]
      }
    },
    "/v1/management/application/logs": {
      "get": {
        "operationId": "application_logs_v1_management_application_logs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeLogs"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Application Logs",
        "tags": [
          "management"
        ]
      }
    },
    "/v1/management/jobs/{job_id}": {
      "get": {
        "operationId": "read_job_v1_management_jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagementJob"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Job",
        "tags": [
          "management"
        ]
      }
    },
    "/v1/management/runtime": {
      "get": {
        "operationId": "runtime_v1_management_runtime_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeContext"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Runtime",
        "tags": [
          "management"
        ]
      }
    },
    "/v1/management/service-status": {
      "get": {
        "operationId": "service_status_v1_management_service_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeploymentServicesOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Service Status",
        "tags": [
          "management"
        ]
      }
    }
  }
}
