{
  "name": "future-props-lab-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build:amadeus-pi --prefix ..",
    "prebuild": "npm run build:amadeus-pi --prefix ..",
    "prebuild:desktop": "npm run build:amadeus-pi --prefix ..",
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/sync-voice-vad-assets.mjs --check && tsc -b && vite build && node scripts/check-bundle-budgets.mjs",
    "build:desktop": "node scripts/sync-voice-vad-assets.mjs --check && tsc -b && vite build --mode desktop && node scripts/check-bundle-budgets.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src tests e2e playwright.config.ts --max-warnings=0",
    "format": "prettier --write src tests e2e *.html *.ts *.json",
    "format:check": "prettier --check src tests e2e *.html *.ts *.json",
    "contracts:generate": "openapi-typescript src/generated/openapi.json -o src/generated/api.ts",
    "contracts:check": "openapi-typescript src/generated/openapi.json | diff - src/generated/api.ts",
    "voice-vad:sync": "node scripts/sync-voice-vad-assets.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.86.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@ricky0123/vad-web": "^0.0.30",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.83.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-details": "^3.31.3",
    "@tiptap/extension-drag-handle": "^3.31.3",
    "@tiptap/extension-drag-handle-react": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-mathematics": "^3.31.3",
    "@tiptap/extension-node-range": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "katex": "^0.16.47",
    "lucide-react": "^1.28.0",
    "mdast-util-to-hast": "^13.2.1",
    "mediabunny": "^1.55.7",
    "mermaid": "11.12.2",
    "onnxruntime-web": "^1.27.0",
    "openapi-fetch": "^0.14.0",
    "pixi.js": "^8.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "unified": "^11.0.5",
    "wavesurfer.js": "7.12.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.8.0",
    "postcss": "^8.5.25",
    "prettier": "^3.6.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
