APP_HOST=127.0.0.1
APP_PORT=9000
# 可选；相对路径以仓库根目录为基准。
FPL_DATABASE_PATH=.runtime/future-props.db
# 单个文件默认最多 200 MiB，可按本机磁盘容量调整。
FPL_VISUAL_ASSET_MAX_BYTES=209715200
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# 生成方式：uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FPL_SECRETS_KEY=replace-with-a-valid-fernet-key
# 可选；配置后必须至少 32 个字符。
FPL_STUDIO_TOKEN=
